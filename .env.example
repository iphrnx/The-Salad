# Supabase (required for Next.js + Edge Function calls)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: local Edge Functions base URL override
# NEXT_PUBLIC_EDGE_BASE=http://localhost:8000/functions/v1

# Edge Function deployment helpers require an explicit project ref.
# SUPABASE_PROJECT_ID=your-project-ref
NEXT_PUBLIC_SITE_URL=http://localhost:3001

